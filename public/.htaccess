# Old URLs requested with the /public prefix go to the clean ones (/public/x -> /x).
# THE_REQUEST is the original request line, so the internal rewrite from the root .htaccess does not trigger this.
# The deploy extractor is called under /public/ and must stay reachable there.
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{THE_REQUEST} ^[A-Z]+\ /public(/|\ |\?)
RewriteCond %{REQUEST_URI} !^/public/deploy-[A-Za-z0-9_]+\.php$
RewriteCond %{REQUEST_URI} ^/public/?(.*)$
RewriteRule ^ https://%{HTTP_HOST}/%1 [R=301,L]
</IfModule>

# Long browser cache for static files. Theme assets carry the build hash in their name,
# WordPress core/plugin assets carry ?ver=, uploads get a new name when edited.
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType text/css "access plus 1 year"
ExpiresByType application/javascript "access plus 1 year"
ExpiresByType text/javascript "access plus 1 year"
ExpiresByType font/woff2 "access plus 1 year"
ExpiresByType font/woff "access plus 1 year"
ExpiresByType image/svg+xml "access plus 1 year"
ExpiresByType image/webp "access plus 1 month"
ExpiresByType image/png "access plus 1 month"
ExpiresByType image/jpeg "access plus 1 month"
ExpiresByType image/gif "access plus 1 month"
</IfModule>

# Same as above for hosts without mod_expires.
<IfModule mod_headers.c>
<FilesMatch "\.(css|js|woff2?|svg)$">
Header set Cache-Control "public, max-age=31536000"
</FilesMatch>
<FilesMatch "\.(webp|png|jpe?g|gif)$">
Header set Cache-Control "public, max-age=2592000"
</FilesMatch>
</IfModule>

# BEGIN WordPress
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /
RewriteRule ^index\.php$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.php [L]
</IfModule>

# END WordPress
