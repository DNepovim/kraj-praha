# Copy to config/.env (untracked). On production the deploy workflow generates it from GitHub Secrets.
# Real environment variables override values from this file.

DB_HOST=mariadb
DB_NAME=test
DB_USER=test
DB_PASSWORD=test

# change salting on production! use https://configenerator.surge.sh/
WP_AUTH_KEY=YFo9OsdGdc CHANGE ON PRODUCTION YFo9OsdGdd
WP_SECURE_AUTH_KEY=rgoJjobcfb CHANGE ON PRODUCTION rgoJjobcfc
WP_LOGGED_IN_KEY=x2GU6Bss6h CHANGE ON PRODUCTION x2GU6Bss6i
WP_NONCE_KEY=kwF7eWA7tw CHANGE ON PRODUCTION kwF7eWA7tx
WP_AUTH_SALT=SbPSqToK6Z CHANGE ON PRODUCTION SbPSqToK6a
