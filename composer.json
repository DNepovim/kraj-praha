{
  "name": "mangoweb/mangopress",
  "description": "ManGoweb's WordPress project boilerplate.",
  "require": {
    "wordpress/wordpress": "*",
    "latte/latte": "^2.11",
    "nette/bootstrap": "^3.2",
    "nette/caching": "^3.3",
    "nette/database": "^3.2",
    "nette/di": "^3.2",
    "nette/finder": "^3.0",
    "nette/forms": "^3.2",
    "nette/http": "^3.3",
    "nette/mail": "^4.0",
    "nette/robot-loader": "^4.0",
    "nette/security": "^3.2",
    "nette/utils": "^4.0",
    "tracy/tracy": "^2.10",
    "mangoweb/mangopress-sql-panel": "dev-master",
    "mangoweb/mangopress-templating": "dev-master",
    "roots/wp-password-bcrypt": "^1.0",
    "uestla/recaptcha-control": "^9.0",
    "wpackagist-plugin/all-in-one-wp-security-and-firewall": "^5.4.0",
    "wpackagist-plugin/wp-smushit": "^4.3.0",
    "wpackagist-plugin/regenerate-thumbnails": "^3.1.0",
    "wpackagist-plugin/html-editor-syntax-highlighter": "^2.2.6",
    "wpackagist-plugin/webp-express": "^0.25.0",
    "wpackagist-plugin/classic-widgets": "^0.3.0",
    "wpackagist-plugin/classic-editor": "^1.6",
    "bugsnag/bugsnag": "^3.31"
  },
  "require-dev": {
    "nette/tester": "^2.5"
  },
  "authors": [
    {
      "name": "ViliamKopecky",
      "email": "vk@viliamkopecky.cz"
    },
    {
      "name": "Matej Simek",
      "email": "email@matejsimek.com",
      "homepage": "http://www.matejsimek.com"
    }
  ],
  "repositories": [
    {
      "type": "composer",
      "url": "https://wpackagist.org"
    },
    {
      "type": "path",
      "url": "packages/mangopress-templating",
      "options": {
        "symlink": false
      }
    },
    {
      "type": "package",
      "package": {
        "name": "wordpress/wordpress",
        "type": "webroot",
        "version": "7.1.4",
        "dist": {
          "type": "zip",
          "url": "https://github.com/WordPress/WordPress/archive/7.1.4.zip"
        },
        "require": {
          "fancyguy/webroot-installer": "1.1.0"
        }
      }
    }
  ],
  "extra": {
    "installer-paths": {
      "public/wp-content/mu-plugins/{$name}/": [
        "type:wordpress-muplugin",
        "type:wordpress-plugin"
      ],
      "public/wp-content/themes/{$name}": [
        "type:wordpress-theme"
      ]
    },
    "webroot-dir": "public/wp-core",
    "webroot-package": "wordpress/wordpress"
  },
  "config": {
    "preferred-install": "dist",
    "optimize-autoloader": true,
    "allow-plugins": {
      "composer/installers": true,
      "fancyguy/webroot-installer": true
    },
    "platform": {
      "php": "8.5.0"
    }
  },
  "minimum-stability": "stable",
  "scripts": {
    "post-update-cmd": [
      "echo Warning: Deleting all .git dirs under vendor ",
      "rm -rf vendor/**/**/.git"
    ],
    "post-install-cmd": [
      "echo Warning: Deleting all .git dirs under vendor",
      "rm -rf vendor/**/**/.git"
    ]
  }
}
